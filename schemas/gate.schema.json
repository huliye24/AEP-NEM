{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep-nem.org/schemas/gate.schema.json",
  "title": "Gate Schema",
  "description": "Schema for a Gate definition (v0.1)",
  "type": "object",
  "required": ["gate_id", "gate_type", "target", "criteria"],
  "properties": {
    "gate_id": {
      "type": "string",
      "description": "Unique identifier for this gate",
      "pattern": "^GATE-[A-Z][A-Z0-9-]*$"
    },
    "gate_type": {
      "type": "string",
      "enum": ["task_gate", "aep_gate", "maturity_gate", "merge_gate", "release_gate"]
    },
    "target": {
      "type": "string",
      "description": "ID of the AEP, NEM, or chain this gate evaluates"
    },
    "target_version": {
      "type": "string"
    },
    "target_maturity": {
      "type": "string",
      "enum": ["BASIC", "STABLE", "ADOPTED", "REFACTORED"]
    },
    "criteria": {
      "type": "object",
      "required": ["must_pass"],
      "properties": {
        "must_pass": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "threshold": {
                "type": "number",
                "description": "Optional numeric threshold"
              }
            }
          }
        },
        "should_pass": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "threshold": { "type": "number" }
            }
          }
        },
        "must_stop": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "evaluator": {
      "type": "string",
      "enum": ["automated", "human", "hybrid"]
    }
  }
}
