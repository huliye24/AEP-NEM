{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep-nem.org/schemas/nem.schema.json",
  "title": "NEM Schema",
  "description": "Schema for a Node Evolution Molecule metadata document. Supports the compact NEM template fields and the current repository's nem_manifest.yaml style.",
  "type": "object",
  "required": ["nem_id", "title", "version"],
  "additionalProperties": true,
  "properties": {
    "nem_id": {
      "type": "string",
      "description": "Unique identifier for this NEM.",
      "pattern": "^NEM-[A-Z][A-Z0-9-]*$",
      "minLength": 5,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "type": "string",
      "enum": [
        "CONCEPT",
        "DRAFT",
        "PENDING",
        "EXPERIMENTAL",
        "HOLD",
        "ADOPT",
        "STABLE",
        "RELEASED",
        "DEPRECATED",
        "concept",
        "draft",
        "pending",
        "experimental",
        "hold",
        "adopt",
        "stable",
        "released",
        "deprecated"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "nem_profile": {
      "type": "string",
      "enum": ["NEM", "NEM-18"],
      "description": "Optional profile name for specialized NEM lifecycle structures."
    },
    "node_formula": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "related_chain": {
      "type": "string"
    },
    "description": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "summary": { "type": "string" },
            "scope": { "type": "string" },
            "out_of_scope": { "type": "string" }
          }
        }
      ]
    },
    "node_goal": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "primary": { "type": "string" },
            "user_or_system_value": { "type": "string" }
          }
        }
      ]
    },
    "included_aeps": {
      "type": "array",
      "items": { "$ref": "#/$defs/aepRef" }
    },
    "constituent_aeps": {
      "type": "array",
      "items": { "$ref": "#/$defs/aepRef" },
      "description": "Legacy/current package-manifest alias for included_aeps."
    },
    "current_stage": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "label": { "type": "string" },
            "description": { "type": "string" }
          }
        }
      ]
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "purpose": { "type": "string" },
          "status": { "type": "string" },
          "aeps": {
            "type": "array",
            "items": { "$ref": "#/$defs/aepRef" }
          },
          "gate": {}
        }
      }
    },
    "maturity": {
      "type": "string",
      "enum": ["BASIC", "STABLE", "ADOPTED", "REFACTORED"]
    },
    "maturity_level": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["BASIC", "STABLE", "ADOPTED", "REFACTORED"]
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "current": { "type": "string" },
            "target": { "type": "string" },
            "criteria": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "interfaces": {
      "$ref": "#/$defs/interfaces"
    },
    "interface": {
      "$ref": "#/$defs/interfaces",
      "description": "Legacy/current package-manifest alias for interfaces."
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedItem" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedItem" }
    },
    "metrics": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" },
              "definition": { "type": "string" },
              "target": { "type": "string" }
            }
          }
        ]
      }
    },
    "gate_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "gate_id": { "type": "string" },
          "date": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["PASS", "FAIL", "HOLD", "NEEDS_REVIEW", "PENDING"]
          },
          "evidence": {}
        }
      }
    },
    "poew_records": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "poew_id": { "type": "string" },
              "date": { "type": "string" },
              "summary": { "type": "string" },
              "evidence": {}
            }
          }
        ]
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required": { "type": "boolean" },
        "report": {
          "type": ["string", "null"]
        },
        "decision": {
          "type": ["string", "null"]
        }
      }
    },
    "next_entry": {
      "type": "object",
      "additionalProperties": true
    },
    "risks": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "risk": { "type": "string" },
              "impact": { "type": "string" },
              "mitigation": { "type": "string" }
            }
          }
        ]
      }
    },
    "roadmap": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "version_or_stage": { "type": "string" },
              "goal": { "type": "string" },
              "planned_aeps": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        ]
      }
    },
    "next_upgrade_direction": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "summary": { "type": "string" }
          }
        }
      ]
    },
    "domain": {
      "type": "string"
    },
    "maturity_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "level": {
            "type": "string",
            "enum": ["BASIC", "STABLE", "ADOPTED", "REFACTORED"]
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "achieved": { "type": "string" },
          "gate": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "aepRef": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "aep_id": { "type": "string" },
            "title": { "type": "string" },
            "status": { "type": "string" },
            "role": { "type": "string" },
            "version": { "type": "string" }
          }
        }
      ]
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "name": { "type": "string" },
                  "capability": { "type": "string" },
                  "description": { "type": "string" },
                  "version": { "type": "string" }
                }
              }
            ]
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "name": { "type": "string" },
                  "capability": { "type": "string" },
                  "description": { "type": "string" },
                  "version": { "type": "string" },
                  "version_or_constraint": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "namedItem": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string" },
            "type": { "type": "string" },
            "source": { "type": "string" },
            "path": { "type": "string" },
            "path_or_interface": { "type": "string" }
          }
        }
      ]
    }
  }
}
