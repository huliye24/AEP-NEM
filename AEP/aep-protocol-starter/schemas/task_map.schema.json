{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEP Task Map Schema v0.1",
  "type": "object",
  "required": [
    "tasks"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "priority",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "status": {
            "enum": [
              "TODO",
              "READY",
              "RUNNING",
              "PASS",
              "FAIL",
              "BLOCKED",
              "SKIPPED",
              "RETRY",
              "DONE"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
